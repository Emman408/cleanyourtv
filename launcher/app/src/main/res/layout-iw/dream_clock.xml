<?xml version="1.0" encoding="utf-8"?>
<!-- Hebrew screensaver: right-aligned clock/date, RTL date text, LTR time numerals. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layoutDirection="rtl"
        android:gravity="right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Ganzhi line above the time (Chinese UI only, kept for view parity with layout/dream_clock.xml). -->
        <TextView
            android:id="@+id/dreamGanzhi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="right"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@string/font_regular"
            android:letterSpacing="0.16"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layoutDirection="ltr"
            android:baselineAligned="true">

            <TextClock
                android:id="@+id/dreamAmPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#99FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />

            <TextClock
                android:id="@+id/dreamClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#E6FFFFFF"
                android:textSize="120sp"
                android:fontFamily="@string/font_extralight"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Date row: the date/weekday, and the lunar line on the same row (Chinese UI only, kept for view
             parity with layout/dream_clock.xml). -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:layoutDirection="ltr"
            android:baselineAligned="true">

            <TextClock
                android:id="@+id/dreamDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textDirection="rtl"
                android:gravity="right"
                android:format12Hour="@string/date_format"
                android:format24Hour="@string/date_format"
                android:textColor="#8CFFFFFF"
                android:textSize="18sp"
                android:fontFamily="@string/font_regular"
                android:letterSpacing="0.14"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/dreamLunar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="right"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#A6FFFFFF"
                android:textSize="18sp"
                android:fontFamily="@string/font_regular"
                android:letterSpacing="0.14"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
