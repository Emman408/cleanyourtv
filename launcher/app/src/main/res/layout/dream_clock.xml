<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): clock and date that drift around a black screen over an ambient glow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Ganzhi (sexagenary) line above the time, filled by ClockScene when ganzhi_date is on and the
             UI language is Chinese, e.g. "丙午 (马) 年 - 戊戌月 - 庚午日". Mirrors Home's ganzhiDate style. -->
        <TextView
            android:id="@+id/dreamGanzhi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="4dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@string/font_regular"
            android:letterSpacing="0.16"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#E6FFFFFF"
                android:textSize="120sp"
                android:fontFamily="@string/font_extralight"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#99FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.08"
                android:textAllCaps="true" />
        </LinearLayout>

        <!-- Date row: the date/weekday, and the lunar line on the same row (like Home) filled by ClockScene
             when lunar_date is on and the UI language is Chinese, e.g. "霜降 九月(大) 十四" (term tinted). -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:format12Hour="@string/date_format"
                android:format24Hour="@string/date_format"
                android:textColor="#8CFFFFFF"
                android:textSize="18sp"
                android:fontFamily="@string/font_regular"
                android:letterSpacing="0.14"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/dreamLunar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#A6FFFFFF"
                android:textSize="18sp"
                android:fontFamily="@string/font_regular"
                android:letterSpacing="0.14"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
